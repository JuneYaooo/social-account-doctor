# =============================================================
# Multimodal analysis (cover / video / screenshot OCR)
# Gemini 3.1 Pro via OpenAI-compatible endpoint
# BASE_URL 必填：脚本不内置任何默认端点（防止 key 发到第三方域名）。
# 可填：OpenAI https://api.openai.com/v1 ｜ SiliconFlow https://api.siliconflow.cn/v1
#       ｜ Gemini 官方兼容端点 https://generativelanguage.googleapis.com/v1beta/openai
#       ｜ 任意自建/可信代理站的 /v1 地址
# =============================================================
VIDEO_ANALYSIS_API_KEY=sk-your-gemini-proxy-key
VIDEO_ANALYSIS_BASE_URL=https://your-gemini-proxy.example.com/v1
VIDEO_ANALYSIS_MODEL_NAME=gemini-3-pro
# Optional multimodal controls
VIDEO_ANALYSIS_TIMEOUT_SECONDS=600
VIDEO_ANALYSIS_NORMALIZE_IMAGES=1
# unset/1 = use video_url when a local video segment is available; 0 = representative-frame fallback
# VIDEO_ANALYSIS_USE_VIDEO_URL=0

# =============================================================
# Audio transcription (only required for `analyze_video.py --mode talking`)
# SenseVoice / Whisper via OpenAI-compatible endpoint
# BASE_URL 必填（如用 SiliconFlow：https://api.siliconflow.cn/v1）
# =============================================================
AUDIO_TRANSCRIPTION_API_KEY=sk-your-asr-proxy-key
AUDIO_TRANSCRIPTION_BASE_URL=https://your-asr-proxy.example.com/v1
AUDIO_TRANSCRIPTION_MODEL=sensevoice
AUDIO_TRANSCRIPTION_TIMEOUT_SECONDS=600

# =============================================================
# TikHub platform data（付费 API，数据源优先级的第三档）
# 优先级：agent 自带 computer use / 浏览器（首选，零配置）> opencli > 本 key
# （付费，稳定，五平台含视频号）> mc（最后手段：上游反爬加剧，账号风控风险最高）
# 申请: https://tikhub.io/
# =============================================================
TIKHUB_API_KEY=your-tikhub-key
