  {
    "name": "kuaishou_app_fetch_tag_feed",
    "description": "话题标签聚合页/Tag feed",
    "method": "GET",
    "path": "/api/v1/kuaishou/app/fetch_tag_feed",
    "inputSchema": {
      "type": "object",
      "properties": {
        "general_tag_id": {
          "type": "string",
          "title": "标签ID/Tag ID",
          "description": "话题标签传标签名或 search_tag 的数字 id；声音标签传编码串"
        },
        "tab": {
          "enum": [
            "hot",
            "latest",
            "image",
            "live"
          ],
          "type": "string",
          "title": "子tab/Sub tab",
          "description": "hot(最热门) / latest(最新发布) / image(图片) / live(直播)",
          "default": "hot"
        },
        "tag_name": {
          "type": "string",
          "title": "标签显示名/Tag name",
          "description": "话题标签建议传，等于标签名"
        },
        "tag_type": {
          "type": "integer",
          "title": "标签类型/Tag type",
          "description": "1=话题标签，29=声音/音乐标签",
          "default": 1
        },
        "tag_source": {
          "type": "integer",
          "title": "标签来源/Tag source",
          "description": "2=搜索进入话题页，3=作品页声音标签",
          "default": 2
        },
        "from_photo_id": {
          "type": "string",
          "title": "源作品ID/Source photo ID",
          "description": "进入标签页的源作品 photoId（可选）"
        },
        "pcursor": {
          "type": "string",
          "title": "分页游标/Pagination cursor",
          "description": "首次留空，翻页传上一页响应的 pcursor",
          "default": ""
        }
      },
      "required": [
        "general_tag_id"
      ]
    },
    "queryParameters": [
      "general_tag_id",
      "tab",
      "tag_name",
      "tag_type",
      "tag_source",
      "from_photo_id",
      "pcursor"
    ],
    "pathParameters": []
  },
